{
  "name": "kino",
  "version": "0.30.2",
  "private": true,
  "description": "Kino — видеоплеер и торрент-клиент для Windows на Tauri, mpv и librqbit",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter @kino/desktop dev",
    "ui": "bun run --filter @kino/ui dev",
    "test": "bun run --filter \"*\" test",
    "typecheck": "bun run --filter \"*\" typecheck",
    "e2e": "bun run --filter @kino/desktop e2e"
  }
}
