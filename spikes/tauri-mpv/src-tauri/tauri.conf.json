{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kino spike",
  "version": "0.1.0",
  "identifier": "local.kino.spike-mpv",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kino spike — mpv под WebView2",
        "width": 1280,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#00000000",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
