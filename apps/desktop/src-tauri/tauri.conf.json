{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kino v2",
  "version": "../../../package.json",
  "identifier": "local.kino.app",
  "build": {
    "devUrl": "http://127.0.0.1:5181",
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run vite:dev",
    "beforeBuildCommand": "bun run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Kino v2",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0e0d0c00",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/thumbs/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Kino",
    "shortDescription": "Видеоплеер и торрент-клиент",
    "icon": [
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mkv",
          "mp4",
          "m4v",
          "avi",
          "mov",
          "webm",
          "wmv",
          "flv",
          "m2ts",
          "mts",
          "mpg",
          "mpeg",
          "vob",
          "ogv",
          "3gp"
        ],
        "name": "Kino.Video",
        "description": "Видео",
        "role": "Viewer"
      },
      {
        "ext": [
          "torrent"
        ],
        "name": "Kino.Torrent",
        "description": "Торрент",
        "mimeType": "application/x-bittorrent",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  }
}
