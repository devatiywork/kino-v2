{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kino",
  "version": "../../../package.json",
  "identifier": "local.kino.app",
  "build": {
    "devUrl": "http://127.0.0.1:5181",
    "frontendDist": "../dist",
    "beforeDevCommand": "bun run vite:dev",
    "beforeBuildCommand": "bun run vite:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Kino",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#0e0d0c00",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/thumbs/*"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
